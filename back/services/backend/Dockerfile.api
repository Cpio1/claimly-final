# Claimly public Backend API. Build context: repository root.
#   docker build -f back/services/backend/Dockerfile.api -t claimly-api .
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app:/app/back/services/backend
WORKDIR /app
COPY back/services/backend/requirements.lock.txt back/services/backend/requirements.lock.txt
RUN pip install -r back/services/backend/requirements.lock.txt
# Shared contracts (2.0.0) and the stateless LLM-package helpers the Backend validates against.
COPY Claimly_Three_Parts/contracts/ Claimly_Three_Parts/contracts/
COPY services/llm/app/__init__.py services/llm/app/config.py services/llm/app/contracts.py services/llm/app/
COPY services/llm/rag/runtime.py services/llm/rag/runtime.py
COPY services/llm/hf-models.lock.json services/llm/hf-models.lock.json
COPY back/services/backend/app/ back/services/backend/app/
COPY back/services/backend/migrations/ back/services/backend/migrations/
RUN useradd --system --uid 10001 claimly && chown -R claimly /app
USER claimly
WORKDIR /app/back/services/backend
EXPOSE 8000
# --host :: listens on IPv4+IPv6 (Railway private network is IPv6). Proxy headers are trusted only
# because the service is reachable solely through the platform edge; set FORWARDED_ALLOW_IPS accordingly.
CMD ["sh", "-c", "exec uvicorn app.main:app --host :: --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips \"${FORWARDED_ALLOW_IPS:-127.0.0.1}\" --no-access-log --timeout-graceful-shutdown 20"]
