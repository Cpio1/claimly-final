# Claimly Backend API + worker. SERVER-SIDE ONLY: never copy any of these into NEXT_PUBLIC_* variables.
# Copy to back/services/backend/.env for local runs (git-ignored). On Railway set them as service variables.

# ── Database (PostgreSQL) ────────────────────────────────────────────────────────────
# Railway: reference ${{postgres.DATABASE_URL}}. Supabase: the pooler/direct URI from the Connect dialog.
DATABASE_URL=
# Local development only: LOCAL_DEV=true allows DATABASE_URL=sqlite:///... and STORAGE_BACKEND=local.
LOCAL_DEV=false

# ── Private original-file storage: s3 | supabase | local ─────────────────────────────
STORAGE_BACKEND=s3
# S3-compatible private bucket (Railway Bucket, Cloudflare R2, AWS S3). Railway: reference the bucket's
# ENDPOINT / BUCKET / REGION / ACCESS_KEY_ID / SECRET_ACCESS_KEY variables.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# virtual (Railway default, AWS) or path (older buckets / some providers; see the bucket Credentials tab)
S3_ADDRESSING_STYLE=virtual
# Supabase Storage alternative (server secret key sb_secret_..., sent as apikey; bucket must be private).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=claimly-documents
# STORAGE_BACKEND=local (LOCAL_DEV only)
LOCAL_STORAGE_DIR=

# ── Browser access ───────────────────────────────────────────────────────────────────
# Exact origins, comma separated, no wildcard/path. Add the HTTP-mode frontend origin(s) only.
FRONTEND_ORIGINS=https://claimly-final.vercel.app
# Behind Railway's edge set FORWARDED_ALLOW_IPS=* so per-IP limits see the real client address.
FORWARDED_ALLOW_IPS=127.0.0.1
DEMO_SESSION_TTL_HOURS=168
DEMO_SESSIONS_PER_IP_PER_HOUR=20
UPLOAD_CONCURRENCY=4

# ── Internal LLM service (private network only) ──────────────────────────────────────
# Railway: http://${{llm.RAILWAY_PRIVATE_DOMAIN}}:8001 ; local: http://127.0.0.1:8001
LLM_BASE_URL=http://127.0.0.1:8001
# Random value of at least 32 bytes, identical on worker and llm service (e.g. `openssl rand -base64 48`).
LLM_SERVICE_TOKEN=

# ── Source-quality gate (owner decision) ─────────────────────────────────────────────
# operator: a trusted operator approves each conversion (python -m app.review) before indexing.
# user_confirmation: clean conversions are indexed and every extracted fact/benefit is flagged for the
#   user's review in the existing review UI. Blocked/unreadable/uncertain conversions never auto-admit.
SOURCE_REVIEW_MODE=operator

# ── Worker ───────────────────────────────────────────────────────────────────────────
JOB_LEASE_SECONDS=1200
JOB_MAX_ATTEMPTS=3
QUARANTINE_HOURS=72
# Embeddings for indexing and questions (same space for both): hf_endpoint | local
EMBEDDING_PROVIDER=hf_endpoint
# hf_endpoint: dedicated HF TEI endpoint for Qwen/Qwen3-Embedding-0.6B at the pinned revision.
HF_TOKEN=
HF_EMBEDDING_URL=
# local: directory with config.json, tokenizer files and model.safetensors of the pinned revision,
# and that file's SHA-256 (verified on load). Requires the worker image built with LOCAL_EMBEDDINGS=true.
EMBEDDING_MODEL_PATH=
EMBEDDING_WEIGHTS_SHA256=
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
# Revisions default to services/llm/hf-models.lock.json; override only together with re-pinning.
# HF_EMBEDDING_REVISION=
EMBEDDING_CHUNK_TOKENS=768

# ── Reminders ────────────────────────────────────────────────────────────────────────
# Bearer secret for POST /internal/v1/reminders/dispatch (cron). In-app deliveries are also
# dispatched by the worker every minute. Email delivery is NOT implemented (email_configured=false).
SCHEDULER_SECRET=
