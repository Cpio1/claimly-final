# Copy to services/llm/.env. Keep filled credentials out of Git.
# Both the backend HTTP client and this service need the same random token.
LLM_SERVICE_TOKEN=
HF_TOKEN=
# Exact TEI prediction URL from the endpoint configuration; do not guess /embed.
HF_EMBEDDING_URL=
# Hosted chat endpoint root or its /v1 base URL, not the model download page.
MODEL_BASE_URL=
MODEL_NAME=Qwen/Qwen3.8-27B
MODEL_TIMEOUT_SECONDS=90
MODEL_INPUT_TOKENS=24000
MODEL_OUTPUT_TOKENS=2048
EMBEDDING_CHUNK_TOKENS=768
# Model revisions and local tokenizer paths default to hf-models.lock.json.
# This service does not need database or Supabase credentials.
