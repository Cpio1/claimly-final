# Copy to .env locally; never commit the filled file. Model-page URLs are not inference URLs.
HF_TOKEN=
# Exact TEI prediction URL from the HF endpoint's generated curl example. Do not guess /embed.
HF_EMBEDDING_URL=
# HF vLLM endpoint root, or its /v1 base URL.
MODEL_BASE_URL=
MODEL_NAME=Qwen/Qwen3.8-27B
MODEL_TIMEOUT_SECONDS=90
MODEL_INPUT_TOKENS=24000
MODEL_OUTPUT_TOKENS=2048
EMBEDDING_CHUNK_TOKENS=768
# Revisions default to the committed hf-models.lock.json; deploy these same revisions on HF.
LLM_SERVICE_TOKEN=
LLM_BASE_URL=http://127.0.0.1:8001
FRONTEND_ORIGINS=http://localhost:8000
DEMO_SESSION_TTL_HOURS=168
# Production: PostgreSQL/Supabase, with an existing PRIVATE bucket.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=claimly-private
# --local launcher sets explicit development storage and a local DB if DATABASE_URL is absent.
LOCAL_DEV_STORAGE=true
# Set LOCAL_DEV_STORAGE=false for production PostgreSQL/Supabase.
