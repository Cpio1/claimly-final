# Root .env is read by compose.yaml (local stack). Never commit the filled file. Server-side values only.
# Full Backend variable reference: back/services/backend/.env.example. Deployment: back/services/backend/DEPLOYMENT.md
LLM_SERVICE_TOKEN=
SCHEDULER_SECRET=
FRONTEND_ORIGINS=http://localhost:3000
SOURCE_REVIEW_MODE=operator
# Protected Hugging Face endpoints (model-page URLs are not inference URLs). Leave empty: AI jobs fail
# honestly with AI_NOT_CONFIGURED / LLM_UNAVAILABLE instead of returning sample answers.
HF_TOKEN=
# Exact TEI prediction URL from the endpoint's generated example (embeddings, worker).
HF_EMBEDDING_URL=
# HF vLLM endpoint root or its /v1 base (chat, llm service).
MODEL_BASE_URL=
MODEL_NAME=Qwen/Qwen3.8-27B
EMBEDDING_PROVIDER=hf_endpoint
